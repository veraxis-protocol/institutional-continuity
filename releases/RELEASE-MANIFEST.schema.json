{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/veraxis-protocol/institutional-continuity/releases/RELEASE-MANIFEST.schema.json",
  "title": "ICI Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release_id",
    "commit_sha",
    "tag",
    "created_utc",
    "claim_ceiling",
    "artifacts"
  ],
  "properties": {
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "commit_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{{40}}$"
    },
    "tag": {
      "type": "string",
      "minLength": 1
    },
    "created_utc": {
      "type": "string",
      "format": "date-time"
    },
    "claim_ceiling": {
      "type": "string",
      "minLength": 1
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "license"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "license": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
